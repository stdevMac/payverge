{
  "name": "payverge-frontend",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.4",
  "scripts": {
    "copy-pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=4096 --no-network-family-autoselection\" next build",
    "typecheck": "rm -rf .next/types && NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=4096\" tsc --noEmit",
    "start": "next start",
    "lint": "eslint src/",
    "test": "jest",
    "test:e2e:staff": "playwright test tests/staff-roles.spec.ts --project=chromium",
    "test:e2e:auth-session": "PLAYWRIGHT_RUN_AUTH_E2E=1 playwright test tests/auth-session-persistence.spec.ts",
    "test:e2e:director": "playwright test tests/director-console.spec.ts",
    "test:e2e:printers": "PLAYWRIGHT_RUN_PRINT_E2E=1 playwright test tests/printer-flow.spec.ts --project=chromium",
    "test:e2e:sidebar-mobile": "playwright test tests/sidebar-mobile-390.spec.ts",
    "test:e2e:menu-print": "playwright test --config=playwright.menu-print.config.ts",
    "test:e2e:menu-print:chromium": "playwright test --config=playwright.menu-print.config.ts --project=chromium",
    "test:e2e:menu-print:live": "PLAYWRIGHT_RUN_MENU_PRINT_E2E=1 playwright test --config=playwright.menu-print.config.ts menu-print-lifecycle.spec.ts --project=chromium",
    "test:e2e:assistant-v2": "PLAYWRIGHT_RUN_ASSISTANT_V2_E2E=1 playwright test assistant-v2.spec.ts --project=chromium --project=mobile-chrome",
    "format": "npx prettier --write \"src/**/*.{ts,tsx}\"",
    "install-hooks": "cd .. && ./scripts/install-hooks.sh",
    "check:compose-env": "tsx ../scripts/check-compose-env-contract.ts",
    "i18n:generate": "tsx scripts/i18n/generate.ts",
    "i18n:check": "tsx scripts/i18n/generate.ts --check",
    "i18n:validate": "tsx scripts/i18n/validate-locales.ts",
    "i18n:report": "tsx scripts/i18n/report-locales.ts",
    "i18n:scaffold": "tsx scripts/i18n/scaffold-locale.ts",
    "test:e2e:qa-pipeline": "PLAYWRIGHT_RUN_QA_PIPELINE=1 playwright test --config=playwright.qa-pipeline.config.ts",
    "check:route-budget": "node scripts/check-route-bundle-budget.js",
    "check:npm-audit": "node scripts/check-npm-audit.js",
    "check:bundle-budget": "node scripts/check-bundle-budget.js",
    "knip": "npx -y knip@6.39.0",
    "knip:production": "npx -y knip@6.39.0 --production --include files,dependencies,unlisted"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@internationalized/date": "^3.12.4",
    "@lifi/sdk": "^4.10.0",
    "@lifi/sdk-provider-ethereum": "^4.2.6",
    "@nextui-org/react": "^2.4.6",
    "@sentry/nextjs": "^10.53.1",
    "@tanstack/react-query": "^5.104.1",
    "@types/lodash": "^4.17.25",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "critters": "^0.0.25",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.5",
    "encoding": "^0.1.13",
    "framer-motion": "^11.2.10",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lodash": "^4.17.23",
    "lucide-react": "^0.564.0",
    "mp4-muxer": "5.2.2",
    "next": "15.5.27",
    "pdfjs-dist": "^4.10.38",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hot-toast": "^2.6.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tailwind-scrollbar": "^3.1.0",
    "viem": "^2.45.3",
    "wagmi": "^3.7.7",
    "zod": "^4.6.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@nextui-org/theme": "2.4.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/fontkit": "^2.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.33",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "axios-mock-adapter": "^2.1.0",
    "babel-jest": "^30.3.0",
    "dom-accessibility-api": "^0.7.1",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.5.16",
    "fontkit": "^2.0.4",
    "glob": "^13.0.6",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "26.1.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "whatwg-fetch": "3.6.20"
  },
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=10.7.0"
  },
  "overrides": {
    "glob": "^13.0.6",
    "h3": "^1.15.5",
    "hono": "^4.12.25",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2",
    "sharp": "^0.35.5",
    "form-data": "^4.0.6",
    "dompurify": "^3.4.5",
    "ws": "^8.21.0",
    "@coinbase/cdp-sdk": {
      "axios": "^1.20.0"
    },
    "jayson": {
      "uuid": "^8.3.2"
    },
    "rpc-websockets": {
      "uuid": "^8.3.2"
    }
  },
  "resolutions": {
    "lit": "3.2.0",
    "@lit/reactive-element": "2.0.4",
    "lit-element": "4.1.0",
    "lit-html": "3.2.0"
  },
  "browserslist": [
    "chrome >= 90",
    "firefox >= 90",
    "safari >= 14",
    "edge >= 90",
    "ios >= 14"
  ]
}
