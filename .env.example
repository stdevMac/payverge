# Payverge development environment for docker-compose.yml (the stack built
# from this checkout).
#
# Usage:
#   cp .env.example .env
#   docker compose --env-file .env config
#   docker compose --env-file .env up -d --build
#
# The values below run on localhost in development mode as they are. The notes
# describe what a public, production-mode deployment needs instead. To run
# Payverge for a restaurant, use deploy/ (deploy/install.sh writes its own
# deploy/.env from deploy/.env.example).
#
# Keep real secrets only in .env or your deployment secret store. Do not commit .env.

# ---------------------------------------------------------------------------
# Deployment mode and host ports
# ---------------------------------------------------------------------------
# ENV or APP_ENV=production switches the backend to production mode: the
# startup preflight then requires an https PUBLIC_URL, real secrets and
# explicit CORS, cookie and proxy settings (.github/e2e/ci.env.fixture is a complete
# production-mode example on localhost).
ENV=development
APP_ENV=development
# Build mode of the frontend image. Leave it at production.
NODE_ENV=production

# Host ports, bound to 127.0.0.1.
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Listen port of the backend process (default 8080). BACKEND_PORT is only the host mapping.
# PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=payverge
DB_PASSWORD=replace_with_strong_database_password
DB_NAME=payverge
DB_SSLMODE=disable
# true logs queries slower than 100ms. Unset keeps the 200ms Warn threshold.
# DB_SLOW_QUERY_LOG=false

# ---------------------------------------------------------------------------
# Instance identity (backend/internal/config/instance.go)
# ---------------------------------------------------------------------------
# Canonical public URL: same origin, API at /api/v1, media at /media/*.
# Required (https) in production.
# CORS, redirect allow-lists, email links and GET /api/v1/instance follow it.
# CORS and redirects trust exactly this origin: if you also serve the www./apex
# counterpart, list it in ALLOWED_ORIGINS and ALLOWED_REDIRECT_DOMAINS.
# Explicit values further down win over or add to these defaults: replace any
# value naming the upstream deployment (APP_BASE_URL,
# ALLOWED_ORIGINS, ALLOWED_REDIRECT_DOMAINS, APP_DOMAIN, COOKIE_DOMAIN,
# FROM_EMAIL*, EMAIL_*_DOMAIN, webhook/OAuth URLs) with your own, or clear it.
PUBLIC_URL=
# Branding and contacts. Empty = defaults: PRODUCT_NAME=Payverge,
# COMPANY_NAME=PRODUCT_NAME, BRAND_COLOR=#1a6b6a, SECURITY_EMAIL=SUPPORT_EMAIL.
# Empty contacts and address render nothing. The From display name is set in
# FROM_EMAIL / FROM_EMAIL_UPDATES, e.g. "Acme <noreply@acme.example>".
# COMPANY_ADDRESS is the postal address in marketing-email footers (CAN-SPAM).
PRODUCT_NAME=
COMPANY_NAME=
COMPANY_ADDRESS=
LEGAL_ENTITY=
# Absolute https URLs of your own terms / privacy pages; when set the frontend
# legal pages redirect there instead of rendering the generic template.
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
SUPPORT_EMAIL=
SECURITY_EMAIL=
LOGO_URL=
BRAND_COLOR=

# ---------------------------------------------------------------------------
# Public URLs, cookies, CORS, and proxy trust
# ---------------------------------------------------------------------------
# Empty = follow PUBLIC_URL above (the single-origin install). Set these only
# for a split deployment where the API lives on its own host, e.g.
#   APP_BASE_URL=https://api.example.com  NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
APP_BASE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Extra origins / redirect hosts beyond PUBLIC_URL, comma-separated, e.g.
#   ALLOWED_ORIGINS=https://pos.example.com,https://www.pos.example.com
#   ALLOWED_REDIRECT_DOMAINS=pos.example.com,www.pos.example.com
#   APP_DOMAIN=pos.example.com
ALLOWED_ORIGINS=
ALLOWED_REDIRECT_DOMAINS=
APP_DOMAIN=
# Auth cookies are set by the API host. Prefer host-only (leave unset/empty) or
# the concrete API host. Do NOT use a leading-dot parent domain like
# .example.com — that sends session/refresh cookies to every subdomain.
COOKIE_DOMAIN=
# TRUSTED_PROXIES — private CIDRs of the reverse proxy in front of the backend
# (Caddy on the compose network). The backend only reads the real client IP
# from X-Forwarded-For when the *immediate* peer is in this list; otherwise
# c.ClientIP() falls back to the peer's address (Caddy's IP) and EVERY request
# shares one rate-limit bucket (the global 300/min limiter throttles the whole
# site, and the per-IP auth limiter can lock out all users after a handful of
# failed logins).
#
# Unset or empty = loopback only (127.0.0.0/8 and ::1, the binary's default),
# which is right only when the proxy runs on the same host as the backend
# process. An explicit value must be private CIDRs only: the Caddy/compose
# network, never a public address.
#
# Self-host topology (deploy/): Caddy is the only peer of Gin, over the private
# compose network. With EDGE=cloudflare it trusts CF-Connecting-IP only from
# the checked-in ranges in deploy/cloudflare-cidrs.caddy. Gin trusts ONLY Caddy.
#
# In the shipped stack, Caddy runs as a SIBLING CONTAINER and reaches the
# backend over the internal bridge network, so the backend sees Caddy's
# container IP (a private bridge address such as 172.18.0.5), NOT 127.0.0.1.
# Trusting the private ranges is safe there because deploy/docker-compose.yml
# never publishes the backend port (the dev docker-compose.yml binds it to
# 127.0.0.1 only), so nothing external can reach it to spoof X-Forwarded-For.
# deploy/docker-compose.yml therefore sets TRUSTED_PROXIES, and the
# frontend's FRONTEND_TRUSTED_PROXIES (empty by default: no peer may pass
# client-identity headers), to the private ranges explicitly. For a narrower
# value, pin the compose network subnet (networks.<name>.ipam.config.subnet)
# and set both variables to match.
#
# Client-IP attribution (P1-2): Caddy REPLACES X-Forwarded-For with its
# verified {client_ip} (see deploy/payverge.caddy + deploy/cloudflare-cidrs.caddy)
# before proxying to Gin, so ClientIP() = real visitor while Gin trusts ONLY
# the private Caddy peer below. Do NOT add Cloudflare's public CIDRs here —
# that alternative only applies if the Caddy rewrite is ever removed, and it
# widens Gin's trust to any host that can reach the backend port directly.
# Verify after any change to this chain: CLIENT_IP_DEBUG=1 + one register
# call, then compare the logged client_ip against your egress IP.
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1
# TRUSTED_PLATFORM must stay BLANK in production. Caddy (not Gin) terminates
# Cloudflare identity; setting this to "cloudflare" would make Gin trust CF
# headers on any direct peer and fails preflight with
# cloudflare.platform.unexpected.
TRUSTED_PLATFORM=

# Per-IP authentication budgets. Staff OTP has an independently conservative
# default (5/minute, burst 2) and can be tuned without weakening owner auth.
AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=3
STAFF_AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=5
STAFF_AUTH_RATE_LIMIT_BURST=2
FORCE_HSTS=false

# ---------------------------------------------------------------------------
# Authentication and admin bootstrap
# ---------------------------------------------------------------------------
# Must be ≥32 random characters (openssl rand -base64 48). Left commented so
# `cp .env.example .env && docker compose up` boots on the compose dev default;
# production refuses that default (placeholder detection), and the self-host
# stack under deploy/ requires its own value in deploy/.env.
# JWT_SECRET_KEY=
# New payment attempts and catalog visibility fail closed in production. Enable
# a provider only after you have run a test payment against its sandbox. Turning
# one off blocks new attempts but deliberately leaves reconciliation running.
PAYMENT_PROVIDER_STRIPE_ENABLED=false
PAYMENT_PROVIDER_PAYPAL_ENABLED=false
PAYMENT_PROVIDER_MERCADOPAGO_ENABLED=false
# Use a random 32-byte value; standard base64 encoding is recommended.
#
# Gates encryption-at-rest for ALL plugin-config secrets (Stripe secret_key,
# PayPal/MercadoPago secrets, webhook signing secrets — B1). When set, those
# fields are stored as v1: AES-256-GCM ciphertext in business_plugins.config and
# transparently decrypted on read. When UNSET, secrets are stored as plaintext
# (current behavior) — so provisioning this key is the opt-in switch. Reads of
# legacy plaintext rows always keep working regardless. Losing this key makes
# already-encrypted secrets unreadable, so back it up like any KMS root secret.
PLUGIN_SECRET_KEY=
# Optional: dedicated HMAC key for crypto quote tokens. Defaults to a value
# derived from JWT_SECRET_KEY. Set explicitly to rotate quote keys independently.
# CRYPTO_QUOTE_SECRET=

# --- Fiscal (Argentina AFIP/ARCA electronic invoicing) ---
# The fiscal job worker ALWAYS runs (no enable flag). Businesses without AFIP
# credentials produce no jobs, so it idles until a business configures fiscal.
# Issuance requires a valid PLUGIN_SECRET_KEY (encrypts/decrypts the stored AFIP
# certificate/key) — in production, credential setup fails closed without it and
# the backend logs a loud startup warning.
# Worker sweep interval in seconds (default 10).
# FISCAL_WORKER_INTERVAL_SECONDS=10

# The print retry + orphan-sweep workers (recover stuck/lost kitchen tickets)
# ALWAYS run — no enable flag.
# Optional overrides for the AFIP WSAA/WSFE endpoints (testing/staging only;
# production resolves the live AFIP hosts automatically from each business's
# environment setting). See docs/fiscal/argentina-afip.md.
# FISCAL_WSAA_URL=
# FISCAL_WSFE_URL=
# Factura B consumidor-final ID threshold in cents (default 1000000000, ARS 10,000,000).
# FISCAL_AR_CF_ID_THRESHOLD_CENTS=1000000000

# Operator inbox (comma-separated) for signup and escalation alerts. Unset
# falls back to SUPPORT_EMAIL, then ADMIN_EMAIL; with none of them set those
# alerts are skipped and startup logs a warning.
ADMIN_EMAILS=

# First platform admin (self-host). Created on first boot with a verified
# email/password login. Password: at least 12 characters, not a placeholder or
# common default. An existing admin keeps its password (never overwritten); an
# existing NON-admin account with this email is taken over (password replaced,
# other logins unlinked, sessions signed out); wallet-linked accounts are
# refused. Remove ADMIN_PASSWORD after the first boot. Forgot it?
#   printf '%s' "$NEW_PASSWORD" | docker compose exec -T backend \
#     /app/server admin reset-password --email you@example.com --password-stdin
# See docs/self-hosting/admin.md.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Who may create an operator account: invite (default) | open | closed.
# Mint invite codes: docker compose exec -T backend /app/server invite create
REGISTRATION_MODE=invite
# true seeds demo restaurants owned by ADMIN_EMAIL on boot (idempotent).
DEMO_DATA=false
# Hosted showroom only: true gives EVERY admin demo data and appends demo days
# hourly. Unset follows DEMO_DATA (append only for the seeded owner).
# ADMIN_DEMO_AUTOMATION_ENABLED=
# Domain for generated demo staff and guest addresses. Empty uses payverge.local.
# ADMIN_DEMO_EMAIL_DOMAIN=payverge.local
# The venue served at "/" (numeric id, /b/<slug> custom URL or business_id
# slug). Empty =
# the only published venue, or a venue directory when several are published;
# with none published "/" goes to the operator sign-in (/dashboard).
PRIMARY_VENUE=

# Local/operator MCP access for admin diagnostics and remediation.
# Generate the raw token with:
#   openssl rand -hex 32
# Prefer storing only the SHA-256 hash on the backend:
#   printf "%s" "$TOKEN" | shasum -a 256 | awk '{print $1}'
# The local MCP process receives the raw token as PAYVERGE_ADMIN_MCP_TOKEN.
PAYVERGE_ADMIN_MCP_TOKEN_SHA256=
# Development-only fallback: raw token accepted directly by the backend.
PAYVERGE_ADMIN_MCP_TOKEN=
# Comma-separated IPs/CIDRs allowed to use the MCP admin token. If blank, the
# backend defaults to loopback only: 127.0.0.1/32,::1/128.
PAYVERGE_ADMIN_MCP_ALLOWED_IPS=127.0.0.1/32,::1/128

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Storage (docs/self-hosting/storage.md)
# ---------------------------------------------------------------------------
# local (default): uploads live on disk under STORAGE_DIR (a docker volume) and
#   public objects are served by the backend at /media/<key>. No account needed.
# s3: an S3-compatible service (AWS S3, MinIO, Cloudflare R2, Garage) using the
#   AWS_* / S3_* values below. They are ignored with the local driver.
STORAGE_DRIVER=local
# Defaults: /data/storage in production mode, ./data/storage otherwise.
STORAGE_DIR=
# Writable directory for instance state that must not be served (default data, /app/data in the image). Keep it outside STORAGE_DIR.
# DATA_DIR=data
# Path-style addressing (http://host/bucket/key). Set true for MinIO/Garage.
S3_FORCE_PATH_STYLE=false
# Media URLs: with PUBLIC_URL (set above) empty they are relative
# (/media/<key>) and survive a host change; with it set they are absolute
# (${PUBLIC_URL}/media/<key>) and pinned to that host. APP_BASE_URL is NOT used
# for media URLs.
# Per-client-IP budget for GET/HEAD /media (exempt from the API limiter, so it
# has its own). Empty = 1800/min with a burst of 600; 0 disables it (use that
# only when a CDN or proxy in front already throttles /media).
MEDIA_RATE_LIMIT_REQUESTS_PER_MINUTE=
MEDIA_RATE_LIMIT_BURST=

AWS_REGION=us-east-1
AWS_ACCESS_KEY=replace_with_public_bucket_access_key
AWS_SECRET_KEY=replace_with_public_bucket_secret_key
S3_BUCKET=replace_with_public_bucket_name
# S3 API (write) endpoint. For Cloudflare R2 this is the account endpoint
# WITHOUT the bucket suffix, e.g. https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://replace-with-s3-endpoint.example.com
# Optional base under which public objects are served directly from the
# bucket: a CDN/custom domain (e.g. https://images.example.com for an R2 custom
# domain) or the public-read bucket's own URL (e.g. https://<bucket>.<e2
# endpoint host> for iDrive e2, https://<bucket>.s3.<region>.amazonaws.com).
# Leave empty to serve them through the backend at /media/<key>; the bucket
# then never needs to be public. Upgrading an install that relied on the old
# "empty = direct bucket URL" behavior: startup logs the exact value to set.
S3_PUBLIC_BASE_URL=

AWS_PROTECTED_ACCESS_KEY=replace_with_protected_bucket_access_key
AWS_PROTECTED_SECRET_KEY=replace_with_protected_bucket_secret_key
S3_PROTECTED_BUCKET=replace_with_protected_bucket_name
S3_PROTECTED_ENDPOINT=https://replace-with-protected-s3-endpoint.example.com
# Leaving S3_PROTECTED_BUCKET empty stores protected objects in S3_BUCKET under
# the "protected/" prefix (never served by /media). At startup the backend
# checks that a protected object cannot be read anonymously and refuses to
# start in production if it can.
# Optional base URL override for protected object location strings. Does NOT
# make protected objects public — they are always read back via authenticated
# GetObject. Usually left empty.
S3_PROTECTED_BASE_URL=

# ---------------------------------------------------------------------------
# Blockchain and frontend contract config
# ---------------------------------------------------------------------------
RPC_URL=https://mainnet.base.org

NEXT_PUBLIC_NETWORK=base
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org
# USDC addresses are hardcoded in frontend/src/lib/lifi/config.ts per chain ID

# ---------------------------------------------------------------------------
# Email, messaging, AI, analytics, and maps
# ---------------------------------------------------------------------------
# Reply-To on transactional mail. Empty falls back to SUPPORT_EMAIL, then to
# no Reply-To header (replies reach FROM_EMAIL). There is no upstream default.
EMAIL_REPLY_TO=
# Transactional From addresses on a domain you have verified with your email
# provider, e.g. FROM_EMAIL=noreply@pos.example.com. Production preflight
# requires both non-empty once a real EMAIL_PROVIDER is set
# (email.from.missing). Also passed as --from-email / --from-email-updates.
FROM_EMAIL=
FROM_EMAIL_UPDATES=
# Email transport (docs/self-hosting/email.md): log | smtp | resend | postmark.
# Left empty it is inferred: resend when RESEND_API_KEY is set, otherwise
# log — mail is not sent; only metadata is logged unless EMAIL_LOG_CONTENT=true. EMAIL_API_KEY alone selects
# nothing; pair it with EMAIL_PROVIDER=resend or postmark.
#   log      -> no delivery; metadata only unless EMAIL_LOG_CONTENT=true
#   smtp     -> any SMTP server; needs SMTP_HOST (587 = STARTTLS, 465 = TLS)
#   resend   -> EMAIL_API_KEY (or RESEND_API_KEY) must be a Resend key (re_...)
#   postmark -> EMAIL_API_KEY (Postmark server token)
# An explicitly chosen provider with missing config is fatal in production.
EMAIL_PROVIDER=
# Log recipients, subject, body preview and links (local evaluation). Off by default.
# EMAIL_LOG_CONTENT=true
# Accept that content in the production log. Without it, EMAIL_LOG_CONTENT=true fails startup.
# EMAIL_PROVIDER_LOG_ALLOW_PRODUCTION=true
EMAIL_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional: overrides the From address on every message sent through SMTP.
SMTP_FROM=
# Optional: auto (default; 465 = implicit TLS, every other port requires
# STARTTLS; only a loopback relay not on 587 upgrades just when offered) |
# starttls | tls | none (trusted local relay only).
SMTP_TLS=
# auto | required | off. auto = off with the log provider (no mail can reach
# anyone), required otherwise. off signs new accounts in without a link but
# never marks them verified (docs/self-hosting/email.md#verification-modes).
EMAIL_VERIFICATION=auto
# Required for Resend in production. The DNS declarations are non-secret
# startup contracts; exact provider-generated record values remain in managed
# DNS/IaC, never in application secrets.
EMAIL_ALLOWED_FROM_DOMAINS=
RESEND_WEBHOOK_SECRET=
EMAIL_SPF_DOMAIN=
EMAIL_DKIM_DOMAIN=
EMAIL_RETURN_PATH_DOMAIN=
EMAIL_DMARC_POLICY=quarantine
# Internal monitored mailbox for the scheduled real-delivery probe.
EMAIL_HEALTHCHECK_TO=

# Durable transactional email outbox (#551). Default ON: every transactional
# send is persisted before the provider is called and delivered by a background
# worker with bounded retries and a dead-letter state. Set to "false" only as an
# emergency rollback to the legacy in-process retry (a crash mid-send then loses
# the message).
EMAIL_OUTBOX_ENABLED=true
# How long an undelivered queued email may wait before the janitor drops it.
EMAIL_OUTBOX_TTL_HOURS=24
# How long terminal rows are kept. The payload holds plaintext recipient/body,
# so keep this short — long enough for delivery webhooks and forensics.
EMAIL_OUTBOX_RETENTION_DAYS=14

# Per-tenant outbound email budget. Every venue-triggered send (receipts, staff
# invites, reservation mail, delivery-order mail to the guest, booking-form and
# delivery-checkout auto-replies, staff, wallet and booking-approval notices to
# the venue's own contact address) is counted per business before the provider
# is called; a refused send returns email_budget_exceeded instead of mailing.
# Delivery order notices to the venue's contact address are not counted yet.
# "Daily" means a 24-hour window that opens with the first counted send and
# resets 24 hours later, per counter; it is not a UTC calendar day. Blank = the
# code default given in each comment. A negative value means unlimited; 0
# blocks that scope entirely.
#
# Daily cap per business, by tier.
# Defaults: standard 1000, demo 20.
EMAIL_TENANT_DAILY_CAP=
EMAIL_TENANT_DEMO_DAILY_CAP=
# How many times one business may mail one recipient per 24-hour window, all
# purposes. Default 20.
EMAIL_TENANT_RECIPIENT_DAILY_CAP=
# Anonymous guest-booking lane: public booking-form auto-replies plus the
# follow-ups for guest-made bookings, and the order-received confirmation of
# the public delivery checkout. The lane's per-business cap is clamped to
# half the tier cap, so anonymous bookings and checkouts can never use up the
# budget operator mail (receipts, invites) needs.
# Default 200 (clamped to tier cap / 2).
EMAIL_TENANT_RESERVATION_DAILY_CAP=
# Per business, per recipient, inside the guest-booking lane. Default 3.
EMAIL_TENANT_RESERVATION_RECIPIENT_DAILY_CAP=
# One recipient across ALL businesses, inside the guest-booking lane only.
# Operator mail never touches this lane-only key, so anonymous bookings cannot
# lock a shared recipient out of another tenant's receipts. Default 10.
# Trade-off: because the key spans venues, bookings typed with someone's
# address at other venues can use up that address's allowance, and a later
# genuine booking-form auto-reply to it is skipped until the window resets (the
# booking itself still stands). Raising this cap trades harassment protection
# for fewer such skips.
EMAIL_TENANT_RECIPIENT_GLOBAL_DAILY_CAP=
# One recipient across ALL businesses, every tenant send of any purpose
# (staff invites, receipts, booking mail). Stops many businesses from each
# mailing one victim up to EMAIL_TENANT_RECIPIENT_DAILY_CAP times a day. Keep it
# above the per-business recipient cap and the lane cap above, so lane mail
# never exhausts it on its own; any purpose. Default 50.
EMAIL_TENANT_RECIPIENT_GLOBAL_ALL_DAILY_CAP=
# An identical message to the same recipient inside this window is sent once.
# 0 disables dedupe. Default 10 (minutes).
EMAIL_TENANT_DEDUPE_MINUTES=
# HMAC key for one-click unsubscribe links. Empty derives one from JWT_SECRET_KEY.
# UNSUBSCRIBE_TOKEN_SECRET=

# Telegram enablement is credential-derived (no enable flags): the notification
# worker runs iff TELEGRAM_TOKEN is set; the public webhook route additionally
# requires TELEGRAM_WEBHOOK_SECRET. Leave both blank to keep Telegram dark.
# TELEGRAM_BOT_USERNAME (your bot's username; a leading @ is ignored) is
# required whenever TELEGRAM_TOKEN is set: without it the operator connect
# link answers 503 telegram_not_configured. There is no upstream default bot.
TELEGRAM_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CONNECTION_TOKEN_TTL_MINUTES=15
TELEGRAM_NOTIFICATION_WORKER_CONCURRENCY=2
TELEGRAM_NOTIFICATION_EVENTS=order.created,payment.received,reservation.created

# The generic plugin payment reconciliation sweep (settles/expires aged pending
# plugin payments when a provider webhook was lost) ALWAYS runs — no enable flag.

# SUPPORT-ESCALATION Telegram bot — a SEPARATE bot from the operator-notification
# bot above (TELEGRAM_TOKEN / TELEGRAM_BOT_TOKEN). Used only to ping the team when
# the Ops Assistant raises a support escalation or a bot fails
# hard. Leave BOTH blank to keep the feature dark (silent no-op, never an error).
TELEGRAM_ESCALATION_BOT_TOKEN=
TELEGRAM_ESCALATION_CHAT_ID=

# WhatsApp AI Waiter integration (whatsmeow-based).
# Off by default. WHATSAPP_ENABLED takes effect ONLY in a backend built with
# the `whatsapp` Go build tag, which links GPL-3.0 code; the default/published
# image ignores it and logs a warning. docker-compose.yml passes GO_TAGS to the
# backend build, so uncommenting both lines below and running
# `docker compose --env-file .env up -d --build` gives a working channel. For
# a stack that pulls a pre-built backend image, build that image yourself with
# `docker build --build-arg GO_TAGS=whatsapp ./backend` and keep it in a
# private registry. Only "true" (case-insensitive) enables it.
# See docs/self-hosting/whatsapp.md.
# GO_TAGS=whatsapp
# WHATSAPP_ENABLED=true
# whatsmeow SQL session store name (default payverge_whatsapp_store).
# WHATSAPP_STORE_NAME=payverge_whatsapp_store

# LLM provider. Default is OpenRouter (one key for all AI features). To use
# any OpenAI-compatible endpoint instead (Ollama, vLLM, LiteLLM), set
# LLM_BASE_URL (e.g. http://ollama:11434/v1) and, if it needs one, LLM_API_KEY.
# OPENROUTER_API_KEY is never sent to a non-OpenRouter LLM_BASE_URL.
# Model ids below then name the endpoint's models. See docs/self-hosting/ai.md.
LLM_BASE_URL=
LLM_API_KEY=
OPENROUTER_API_KEY=
# Extra model prices, USD per 1M tokens: model=in/out,... (0/0 is valid).
# Local endpoints (loopback/private IP, compose service name, *.local,
# host.docker.internal) book unpriced models at $0. A hosted vendor
# (e.g. https://api.openai.com/v1) needs every model priced here, or
# budget-capped AI calls are refused.
OPENROUTER_PRICES=
# Model overrides (defaults keep current Gemini models via OpenRouter IDs)
OPENROUTER_MODEL_CHAT=google/gemini-2.5-flash
OPENROUTER_MODEL_MENU=google/gemini-2.5-flash
OPENROUTER_MODEL_IMAGE=google/gemini-2.5-flash-image
OPENROUTER_MODEL_DIRECTOR=google/gemini-2.5-flash
OPENROUTER_MODEL_GUARDRAIL=google/gemini-2.5-flash-lite
# Optional comma-separated fallback model lists (OpenRouter models[] array)
OPENROUTER_CHAT_FALLBACKS=
OPENROUTER_MENU_FALLBACKS=
OPENROUTER_IMAGE_FALLBACKS=
OPENROUTER_DIRECTOR_FALLBACKS=
OPENROUTER_GUARDRAIL_FALLBACKS=
# GUARDRAIL_STRICT: public AI-waiter guardrail failure posture.
# Unset => production defaults to fail-CLOSED (block on guardrail outage),
# dev defaults to fail-open. Set true/false to override explicitly.
GUARDRAIL_STRICT=
# AI spend ceilings (USD per UTC day). Mandatory whenever an LLM provider is
# configured, in every mode: unset, 0, negative or unparseable values fall back
# to the default (caps cannot be disabled). Backstops the per-conversation
# message-count caps across waiter/director/ops/WhatsApp.
# Layout inside the global ceiling (defaults in brackets):
#   guest pool [$10]   guest AI waiter turns (web + WhatsApp) at ALL venues.
#                      Each venue's guests get min(per-business, pool / 4)
#                      [$2.50], so it takes at least 4 venues spending their
#                      full share to close guest AI for everyone else.
#   owner reserve [$10] global - pool: owner/staff tools only; anonymous
#                      traffic can never spend it.
# Empty global/pool values are derived from the ones above them, so raising
# the per-business cap never gets silently truncated by a stale instance
# default. Incoherent explicit values (pool >= global, which leaves owners no
# reserve) are logged as warnings at boot; the effective caps are logged on
# startup.
# Per business, for the owner/staff tools. Default 5. Alias:
# AI_BUDGET_PER_BUSINESS_USD_DAY.
AI_DAILY_BUDGET_USD=5
# Instance-wide ceiling across every business and lane.
# Empty = max(20, 2 x AI_DAILY_BUDGET_USD) => 20 with the default above.
AI_BUDGET_GLOBAL_USD_DAY=
# Guest pool inside the global ceiling (see the layout above).
# Empty = AI_BUDGET_GLOBAL_USD_DAY / 2 => 10 with the defaults. A single-venue
# install that wants its guests to get the full per-business cap sets this to
# 4 x AI_DAILY_BUDGET_USD and raises AI_BUDGET_GLOBAL_USD_DAY to cover pool +
# an owner reserve (per-business 5, pool 20 => set global to 25 or more).
AI_BUDGET_GUEST_POOL_USD_DAY=
# AI waiter messages per business per UTC day, on HTTP and WhatsApp (default 2000).
# AI_WAITER_DAILY_MESSAGE_BUDGET=2000
# Guest/public AI abuse ceilings, counted per UTC day in memory on each
# replica (the USD caps above stay the durable backstop). Empty = default.
# With N backend replicas each one counts separately, so the effective
# ceiling is up to N x the value. Per-network keys use the client IP Gin
# derives through TRUSTED_PROXIES (see the top of this file): if that is
# wrong, every visitor shares the proxy's address and one ceiling.
# AI waiter turns per client network (IPv4 address / IPv6 /64). Default 600:
# generous because a venue's guest Wi-Fi puts many diners behind one address.
AI_WAITER_DAILY_MESSAGES_PER_IP=
# AI waiter turns per device (server-signed pv_ai_device cookie). Default 150.
# Also the daily ceiling per WhatsApp sender number (all its linked devices).
AI_WAITER_DAILY_MESSAGES_PER_DEVICE=
# AI data retention (days). 0 disables the corresponding janitor in every mode
# (production included) and keeps those rows indefinitely; keep the defaults
# unless your own privacy policy promises something else.
AI_TRANSCRIPT_RETENTION_DAYS=90
OPS_ASSISTANT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Spaces & Tables — phone-scan floor-plan capture
# (Live map / reservations / table create-update do not require these vars;
#  they only apply when operators use the phone-scan path.)
# ---------------------------------------------------------------------------
# Session TTL for QR/opaque scan tokens (default 30 minutes).
SPACE_SCAN_SESSION_TTL_MINUTES=30
# Max bytes per upload part (default 25 MiB).
SPACE_SCAN_MAX_UPLOAD_BYTES=26214400
# Days to retain raw scan artifacts before S3/.local cleanup (default 7).
# 0 disables the retention janitor in every mode and keeps raw uploads.
SPACE_SCAN_RAW_RETENTION_DAYS=7
# Max keyframe frames accepted in one upload (default 120).
SPACE_SCAN_MAX_FRAMES=120
# Local dev: when protected S3 is unavailable, scan artifacts are stored under
# .local/space-scans/ with the same ArtifactStore interface (gitignored).
# AI privacy / ZDR (OpenRouter zero-data-retention routing)
# audit = log gaps; enforce = fail startup if sensitive models missing from allowlist.
# Empty = enforce in production mode, audit otherwise. The production
# preflight rejects audit when the endpoint is OpenRouter, so leave it empty
# unless you need audit on a hosted non-OpenRouter LLM_BASE_URL.
OPENROUTER_ZDR_MODE=
# Comma-separated OpenRouter model IDs proven under ZDR. Empty allowlist bootstraps
# from configured models in enforce mode (set explicitly after staging proof).
OPENROUTER_ZDR_APPROVED_MODELS=
# Ranking headers sent to OpenRouter only (optional).
# Empty = PUBLIC_URL / PRODUCT_NAME.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_PLACES_API_KEY=

POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ---------------------------------------------------------------------------
# Payments and webhooks
# ---------------------------------------------------------------------------
# Caps a single alternative-payment amount in cents (sanity ceiling against a
# caller sending dollars-as-int). Default 100000000 ($1,000,000); a blank,
# non-numeric, or non-positive value falls back to the default.
MAX_PAYMENT_AMOUNT_CENTS=100000000

# --- Payment safety knobs (optional; blank = code defaults) ---
# Hard per-payment ceiling in cents; requests above it are rejected.
# Blank/non-numeric/non-positive falls back to 100000000 ($1,000,000) — same as above.
# MAX_PAYMENT_AMOUNT_CENTS is documented immediately above.
# Allow automated USDC refunds on mainnet (true/false). Blank/false keeps refunds manual-review only.
CRYPTO_REFUND_MAINNET_ENABLED=
# Refund confirmation poll interval in seconds (default 15).
# CRYPTO_REFUND_WORKER_INTERVAL_SEC=15
# Parallel refund confirmations (default 2).
# CRYPTO_REFUND_WORKER_CONCURRENCY=2
# Max age (minutes) of a cached exchange-rate quote before crypto quotes refuse to price.
# Blank or invalid => code default 360 (6 hours).
QUOTE_RATE_MAX_AGE_MINUTES=
# Reject an exchange rate that moves more than this factor from the last accepted rate (default 10).
# EXCHANGE_RATE_MAX_STEP_FACTOR=10
# On-chain confirmations required before a USDC payment settles. Blank/invalid => code default 3.
USDC_MIN_CONFIRMATIONS=
# Reorg reconciler. Anything but false runs it when an RPC verifier is dialed; it alerts and does not reverse the ledger.
# REORG_WATCH_ENABLED=true
# Minutes of recently confirmed payments the reconciler rechecks (default 30).
# REORG_FINALITY_WINDOW_MIN=30
# Minimum seconds between checks of one payment (default 120).
# REORG_WATCH_COOLDOWN_SEC=120
# Seconds a missing transfer must persist before an alert (default 300).
# REORG_SUSPICION_GRACE_SEC=300
# Payments rechecked per sweep (default 100).
# REORG_WATCH_BATCH=100
# Sweep interval in seconds (default 60).
# REORG_WATCH_INTERVAL_SEC=60

STRIPE_PLUGIN_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
# Platform Connect webhook signing secret (Connect → Webhooks in Stripe Dashboard).
# Used for OAuth-connected accounts and account.application.deauthorized events.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Stripe Connect OAuth (Standard accounts) — one-click merchant connect for the
# Stripe payment plugin. Redirect URI: {APP_BASE_URL}/api/v1/stripe/oauth/callback
# (register in Stripe Dashboard → Connect → Onboarding options → OAuth).
STRIPE_CONNECT_CLIENT_ID=
# Platform secret key (sk_live_… / sk_test_…) used for Connect token exchange and
# Stripe-Account API calls on behalf of connected accounts. Direct charges only
# (no application_fee_amount).
STRIPE_SECRET_KEY=
PAYPAL_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
# Previous webhook secret retained during rotation (VerifyWebhookRequest env fallback).
MERCADOPAGO_WEBHOOK_SECRET_PREVIOUS=
# Platform OAuth application (Developers panel) — required for one-click Connect
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Payment provider sandbox credentials. The app never reads these: only the
# opt-in live sandbox tests do (cd backend && go test -tags integration
# ./internal/plugins/paypal ./internal/plugins/mercadopago -run SandboxIntegration -v).
# Leave them empty unless you run those tests.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
MERCADOPAGO_SANDBOX_ACCESS_TOKEN=
MERCADOPAGO_SANDBOX_PUBLIC_KEY=
MERCADOPAGO_SANDBOX_CURRENCY=ARS
MERCADOPAGO_SANDBOX_WEBHOOK_SECRET=
# Publicly reachable API origin for sandbox webhooks (e.g. an ngrok tunnel).
PAYVERGE_PUBLIC_WEBHOOK_BASE_URL=

# ---------------------------------------------------------------------------
# Observability and maintenance gates
# ---------------------------------------------------------------------------
# The default is filtered as a placeholder at startup — /metrics will NOT
# register behind a published bearer token. Set a real token to activate.
METRICS_TOKEN=replace_with_metrics_bearer_token
METRICS_TOKENS=
# Optional bearer/query token that unlocks detailed /api/v1/health and
# /api/v1/health/ready payloads (component matrix, DB latency, uptime,
# goroutines). Unset → those routes return status-only on the public internet.
HEALTH_DETAIL_TOKEN=
# Token for GET /internal/_pprof_snapshot (header X-Pprof-Token). Unset leaves the route unregistered.
# PPROF_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=dev
SENTRY_ENABLED=
SENTRY_ENABLE_LOGS=false
SENTRY_ENABLE_TRACING=true
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_LOG_LEVELS=error,fatal,panic

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=dev
NEXT_PUBLIC_SENTRY_ENABLED=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.01
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

SENTRY_ORG=
SENTRY_FRONTEND_PROJECT=payverge-frontend
SENTRY_AUTH_TOKEN=

# Maintenance gate. The frontend reads it at runtime, so a
# container restart applies it (docs/self-hosting/frontend-config.md). The
# NEXT_PUBLIC_* spellings are still accepted as a build-time fallback for old
# images; prefer the plain names.
MAINTENANCE_MODE=false

NEXT_PUBLIC_RELEASE_SHA=dev
NEXT_PUBLIC_VERSION=unknown
NEXT_PUBLIC_BUILD_TIMESTAMP=unknown
SITEMAP_SKIP_REMOTE=false

# ---------------------------------------------------------------------------
# Backup for source-built installs: backend/scripts/backup-db.sh and the
# restore drill (backend/scripts/run-restore-drill.sh) read these. The root
# docker-compose.yml does not run backups. Self-hosters using deploy/ get the
# `backup` profile instead, configured in deploy/.env (deploy/README.md).
# ---------------------------------------------------------------------------
BACKUP_DIR=./backups
# backup-db.sh prunes local dumps older than this many days.
RETENTION_DAYS=7

# Off-host backup upload. Use a DEDICATED bucket + IAM credentials with
# PutObject/HeadObject/HeadBucket rights (never reuse the app's public/
# protected media buckets or keys). For Cloudflare R2 set
# S3_BACKUP_ENDPOINT to the account endpoint (e.g. https://<accountid>.r2.cloudflarestorage.com).
#
# REQUIRE_OFFSITE_BACKUP=true: a backup only
# counts as durable once the dump is verified off-host. Fail-fast if the
# bucket is empty, aws CLI is missing, or head-bucket fails. Policy marker
# .last-success is written only after a successful S3 upload (+ head-object).
# Local-only success writes .last-local-success but not .last-success when
# offsite is required and upload fails.
# REQUIRE_OFFSITE_BACKUP=false (default for local/dev): if S3_BACKUP_BUCKET is
# unset, local dump success is policy success. If the bucket is set, upload
# is still attempted and policy success still requires a successful upload.
#
# Marker files under BACKUP_DIR:
#   .last-local-success  — dump passed gzip -t and was published
#   .last-upload-success — S3 object confirmed
#   .last-success        — policy timestamp plus local file and off-site object ID
#
# S3 retention is provisioned by infra/backup/backup-stack.json (30-day current,
# 7-day noncurrent/Object Lock). Retention is not enforced by the backup script.
#
# The restore drill needs READ access to this bucket (List + Get under
# S3_BACKUP_PREFIX); infra/backup/iam-restore-policy.json is the template.
# REQUIRE_OFFSITE_BACKUP=false
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=db
S3_BACKUP_ENDPOINT=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
