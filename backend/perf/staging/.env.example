# Staging-perf .env template. Copy to `.env` and fill in real values before
# bringing the stack up. Compose only injects vars referenced in the compose
# file, so `--env-file .env` is required (see README.md "Safety" section).

# --- Required secrets ---
JWT_SECRET_KEY=change-me-to-a-real-secret
PPROF_TOKEN=change-me-to-a-secure-pprof-token
METRICS_TOKEN=change-me-to-a-metrics-token

# --- Database (defaults match the docker-compose service names) ---
DB_USER=payverge
DB_PASSWORD=change-me-to-a-real-password
DB_NAME=payverge
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable

# --- Image to pull: <prefix>-backend:<tag> (release images: ghcr.io/stdevmac/payverge-backend) ---
# No perf-latest tag is published from this repository; point these at a
# backend image you built and pushed (README.md section 2).
PAYVERGE_IMAGE_TAG=perf-latest
PAYVERGE_IMAGE_PREFIX=ghcr.io/stdevmac/payverge

# --- Environment marker ---
ENV=staging
APP_ENV=staging

# --- Stripe sandbox (test-mode keys only — never put real Stripe keys here) ---
STRIPE_SECRET_KEY=sk_test_replace_with_test_mode
STRIPE_PUBLIC_KEY=pk_test_replace_with_test_mode

# --- Optional: PostHog perf tracking ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# --- Optional: backend port override (default 8080) ---
BACKEND_PORT=8080
