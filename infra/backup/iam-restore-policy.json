{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackupPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::<BACKUP_BUCKET>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "db",
            "db/*"
          ]
        }
      }
    },
    {
      "Sid": "GetBackupObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::<BACKUP_BUCKET>/db/*"
    }
  ]
}
