# CI-only environment for the nightly E2E docker-compose stack.
# Committed, non-secret, deterministic. Satisfies production preflight
# (backend/internal/config/production_preflight.go) with ENV=production while
# contacting NO live provider and using NO real payverge endpoints/credentials.
#
# Used by: .github/workflows/e2e.yml
#   cp .github/e2e/ci.env.fixture .env
#   docker compose --env-file .env config
#   docker compose --env-file .env up -d --build
#
# S3 values are MinIO-shaped dummies that satisfy preflight only. Existing
# Playwright journeys do not exercise live object storage, so no MinIO
# container is wired. Email uses a stub Postmark token (no outbound mail).

# ---------------------------------------------------------------------------
# Deployment mode and host ports
# ---------------------------------------------------------------------------
NODE_ENV=production
ENV=production
APP_ENV=production
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL (service name postgres; seed uses payverge/payverge)
# ---------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=payverge
DB_PASSWORD=payverge_ci_password
DB_NAME=payverge
DB_SSLMODE=disable

# ---------------------------------------------------------------------------
# Public URLs, cookies, CORS, proxy trust (localhost only)
# ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:8080
PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Next.js server-side fetches run inside the frontend container.
INTERNAL_API_URL=http://backend:8080/api/v1
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@local.test
# No longer read: frontend/src/config/publicConfig.ts accepts plain http for
# loopback and private-network hosts on its own (docs/self-hosting/
# frontend-config.md). Left set until the compose/CI env cleanup drops it.
NEXT_PUBLIC_ALLOW_INSECURE_URLS=true

ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_REDIRECT_DOMAINS=localhost
APP_DOMAIN=localhost
# Host-only / concrete host. Parent domains (example.com / .example.com) fail preflight.
COOKIE_DOMAIN=localhost
# Caddy is the only Cloudflare-aware hop. Gin trusts only the private compose
# network where Caddy reaches the backend; it must not parse CF headers itself.
TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PLATFORM=
FORCE_HSTS=false

# Release smoke drives many owner setup flows from one CI runner IP. Keep
# production defaults strict, but give the deterministic CI stack enough local
# auth/form budget to prove app behavior instead of tripping abuse controls.
GLOBAL_RATE_LIMIT_REQUESTS_PER_MINUTE=10000
AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=120
AUTH_RATE_LIMIT_BURST=30
REGISTRATION_RATE_LIMIT_PER_HOUR=120
STAFF_AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=120
STAFF_AUTH_RATE_LIMIT_BURST=30
PUBLIC_FORM_RATE_LIMIT_REQUESTS_PER_MINUTE=60
PUBLIC_FORM_RATE_LIMIT_BURST=20

# ---------------------------------------------------------------------------
# Auth / plugin encryption (CI-only; generated with openssl, not production)
# ---------------------------------------------------------------------------
# JWT: 64 hex chars (openssl rand -hex 32) — CI-only, not a placeholder.
JWT_SECRET_KEY=a0485172a71b547531390b0b03fb0c6ee13b67e3d14edff5440cb3b1c3d1f569
# base64 of 32 random bytes (openssl rand -base64 32) — CI-only.
PLUGIN_SECRET_KEY=bp6sWDGc8EvF2bUYD1POWwAIISfH7KDK38RixPgDHEI=

ADMIN_EMAILS=admin@localhost

# ---------------------------------------------------------------------------
# Storage — MinIO-style local doubles (preflight only; no live S3)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY=ci_minio_access_key
AWS_SECRET_KEY=ci_minio_secret_key_not_real
S3_BUCKET=payverge-ci-public
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/payverge-ci-public

AWS_PROTECTED_ACCESS_KEY=ci_minio_protected_access
AWS_PROTECTED_SECRET_KEY=ci_minio_protected_secret_not_real
S3_PROTECTED_BUCKET=payverge-ci-protected
S3_PROTECTED_ENDPOINT=http://minio:9000
S3_PROTECTED_BASE_URL=

# ---------------------------------------------------------------------------
# Blockchain (inert local RPC — no live chain)
# ---------------------------------------------------------------------------
RPC_URL=http://localhost:8545
NEXT_PUBLIC_NETWORK=baseSepolia
NEXT_PUBLIC_RPC_URL=http://localhost:8545

# ---------------------------------------------------------------------------
# Email stub (no outbound delivery)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=postmark
EMAIL_API_KEY=ci-stub-token
FROM_EMAIL=noreply@localhost
FROM_EMAIL_UPDATES=updates@localhost

# ---------------------------------------------------------------------------
# Messaging — no Telegram credentials in CI, so the worker and webhook stay
# dark (enablement is credential-derived: worker iff TELEGRAM_TOKEN, webhook
# additionally iff TELEGRAM_WEBHOOK_SECRET)
# ---------------------------------------------------------------------------
TELEGRAM_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_NOTIFICATION_WORKER_CONCURRENCY=2
TELEGRAM_ESCALATION_BOT_TOKEN=
TELEGRAM_ESCALATION_CHAT_ID=

# ---------------------------------------------------------------------------
# AI spend caps (production preflight requires positive decimals)
# ---------------------------------------------------------------------------
AI_DAILY_BUDGET_USD=5
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Payverge-CI
# Inert local OpenAI-compatible endpoint (discard port; nothing listens, so
# no model call leaves the backend container). It makes the instance report
# features.ai=true and the guest waiter run in "llm" mode, which the
# assistant-v2 journeys need: they drive the real Ops Assistant / AI waiter UI
# and intercept only the model-facing endpoints in the browser.
LLM_BASE_URL=http://127.0.0.1:9/v1

# ---------------------------------------------------------------------------
# Migration safety
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Frontend gates and build metadata (docker compose passes them to the image
# build and to the container; the frontend reads each one at whichever stage
# it supports)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_RELEASE_SHA=ci
NEXT_PUBLIC_VERSION=ci
NEXT_PUBLIC_BUILD_TIMESTAMP=ci

# ---------------------------------------------------------------------------
# Observability (disabled / inert)
# ---------------------------------------------------------------------------
METRICS_TOKEN=ci_metrics_token_not_for_production_use_32
SENTRY_DSN=
SENTRY_ENVIRONMENT=ci
SENTRY_RELEASE=ci
SENTRY_ENABLED=false
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_FRONTEND_PROJECT=payverge-frontend
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=ci
NEXT_PUBLIC_SENTRY_ENABLED=false

# ---------------------------------------------------------------------------
# Optional compose interpolations (empty is fine)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_PLACES_API_KEY=
POSTHOG_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ci@localhost
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
STRIPE_PLUGIN_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_OAUTH_SECRET=
PAYPAL_REDIRECT_URI=http://localhost:8080/api/v1/paypal/oauth/callback
