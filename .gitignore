# Environment variables: every .env variant except the committed templates.
.env
.env.*
.env-*
.env_*
*.env
.envrc
.envrc.*
!.env.example
!**/*.example

# Key material: TLS keys, certificate bundles and keystores.
*.pem
*.key
*.p12
*.pfx

# Database backups and the success markers backup scripts write next to them
# (backend/scripts/backup-db.sh: .last-success, .last-local-success, ...).
backups/
**/.last-success
**/.last-*-success

# Database and credential exports are local-only.
*.dump
*.sql.gz
credential-exports/

# Self-host install state written by deploy/ (database dumps and the rclone
# remote configuration hold customer data and credentials).
/deploy/backups/
/deploy/rclone/
# Public demo pristine snapshot (deploy/demo/reset-demo.sh --snapshot).
/deploy/demo/pristine/
# Local compose overrides (host-specific ports, secrets): never tracked.
/docker-compose.override.yml
/deploy/docker-compose.override.yml

# Dependencies
node_modules/
*/node_modules/

