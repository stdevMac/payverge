# .dockerignore

.worktrees/

# Local audit / launch artifacts (never commit — contain test fixtures + login bypass details)
/STAFF-AUDIT-*.md
/CODEBASE-AUDIT-*.md
/CODEBASE_AUDIT_*.md
/BLOG-LAUNCH-REPORT.md
/audit-*.png
/.audit-*/
/code-audit-*.md
/test-results/
/frontend/test-results/

# Per-tool AI assistant directories and skill installs are local-only. The one
# exception is the shared project skills: exactly .claude/skills/<name>/SKILL.md
# (plain Markdown, see docs/agents/README.md). Everything else under .claude/
# stays ignored, including settings, worktrees, local commands and any other
# file or folder dropped next to a SKILL.md (scripts, notes, private skills'
# extras), so nothing beside the playbooks can be staged by accident.
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/*/
/.claude/skills/*/*
!/.claude/skills/*/SKILL.md
*/**/.claude/
.grok/
.agents/
.design-sync/
.emdash.json
skills-lock.json
.agent/
.gemini/
.windsurf/
.opencode/
.cursor/
.aider*
.serena/
.superpowers/
.playwright-mcp/

# Local audit binaries (docx exports, kept locally under .local/audit-exports/)
payverge-code-audit-*.docx
payverge-codebase-audit-*.docx
payverge-audit-*.docx
payverge_code_audit_*.docx
/codebase-audit-*.docx

# Local artifacts from generative tooling (investor decks, etc.) — not project source
/outputs/

# Videogen render runs (frames/shots/composites, ~100MB+ each)
/runs/

# Bench artifacts (generated by `make bench-ci`)
backend/bench.txt
backend/bench.raw.txt
backend/delta.txt
backend/.perf-profiles/

# Marketing brag/sizzle render output (large binaries; keep on disk, out of git)
brag-output-*/

# Local-only workspace (database dumps, QA credentials, run evidence)
.local/

# Local video/media production workspaces (multi-GB renders, stock, audio — keep on disk, out of git)
/videos/
/.grok-media/
/frames/
/marketing/
/stdevMac/
/transcript/
/notion.mp4
/notion_audio.wav

# Stray root screenshots — the repo root is a closed file set (AGENTS.md §3.1)
/*.png
/*.jpg
/*.jpeg
/*.webp

# Design-system bundle build output (frontend/ds)
.ds-sync/
ds-bundle/
frontend/ds/dist/
frontend/ds/styles.css
frontend/ds/asset-shim.css
